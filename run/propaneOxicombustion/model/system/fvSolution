FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "rho.*"
    {
        solver          diagonal;
    }

    p
    {
        // solver           GAMG;
        // smoother         DICGaussSeidel;
        // tolerance        0;
        // relTol           0.05;
        // maxIter          50;
        solver           PCG;
        preconditioner   DIC;
        tolerance        1e-6;
        relTol           0.1;
    }

    pFinal
    {
        $p;
        relTol           0;
    }

    "(U|h|k|epsilon)"
    {
        // solver          smoothSolver;
        // smoother        GaussSeidel;
        // tolerance       0;
        // relTol          0.1;
        // maxIter         20;
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-6;
        relTol          0.1;
    }

    "(U|h|k|epsilon)Final"
    {
        $U;
        relTol          0.1;
    }

    "Yi.*"
    {
        $U;
        relTol          0.1;
    }
}

PIMPLE
{
    transonic                no;
    momentumPredictor        yes;
    nOuterCorrectors         1;
    nCorrectors              2;
    nNonOrthogonalCorrectors 0;

    maxDeltaT                1.0e-03;
    maxCo                    0.5;

    rDeltaTSmoothingCoeff    1;
    rDeltaTDampingCoeff      1;

    alphaTemp                0.05;
    alphaY                   1.0;

    Yref
    {
        O2    0.1;
        C3H8  0.1;
    }
}


relaxationFactors
{
    fields
    {
        p               0.3;
        rho             1.0;
    }

    equations
    {
        U               0.7;
        h               0.7;
        ".*"            0.7;
    }
}

