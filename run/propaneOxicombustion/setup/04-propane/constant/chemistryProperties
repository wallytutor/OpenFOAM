FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      chemistryProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

chemistryType
{
    solver            EulerImplicit;
}

chemistry           on;

initialChemicalTimeStep 1e-07;

EulerImplicitCoeffs
{
    cTauChem        1;
}

odeCoeffs
{
    solver          Rosenbrock43;
    absTol          1e-8;
    relTol          0.01;
}

reactions
{
    propaneSingleStep
    {
        // 10.1080/00102208108946970
        type     irreversibleArrhenius;
        reaction "C3H8^0.1 + 5O2^1.65 = 3CO2 + 4H2O";
        A        8.6e+11;
        beta     0;
        Ta       15097.0;
    }
}

