FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      radiationProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

radiation  on;

solverFreq 10;

// --------------------------------------------------------------------

radiationModel  P1;

// XXX: cannot be used with wedges/cyclic
// radiationModel  fvDOM;
//
// fvDOMCoeffs
// {
//     nPhi        4;    // azimuthal angles in PI/2 on X-Y.(from Y to X)
//     nTheta      0;    // polar angles in PI (from Z to X-Y plane)
//     tolerance   1e-2; // convergence tolerance for radiation iteration
//     maxIter     4;    // maximum number of iterations
// }

// --------------------------------------------------------------------

// If not modeling particles, then use these:
// absorptionEmissionModel constant;
// absorptionEmissionModel greyMeanCombustion;
// scatterModel            none;

// If modeling particles, then these are suitable:
absorptionEmissionModel binary;
scatterModel            cloud;

// These are in external files to keep a single source of truth as
// they are also used in `binaryCoeffs` below:
#include "radiationCoeffs"

binaryCoeffs
{
    model1
    {
        // absorptionEmissionModel constant;
        absorptionEmissionModel greyMeanCombustion;

        #include "radiationCoeffs"
    }

    model2
    {
        absorptionEmissionModel cloud;

        cloudCoeffs
        {
            cloudNames
            (
                cloudLimestone
            );
        }
    }
}

cloudCoeffs
{
    cloudNames
    (
        cloudLimestone
    );
}

// --------------------------------------------------------------------

// If soothing is to be added, then the mixtureFractionCoeffs need a fix
// https://cpp.openfoam.org/v13/classFoam_1_1radiationModels_1_1sootModels_1_1mixtureFraction.html
// Please notice that it is purely an state model with forced fraction.
// sootModel  mixtureFraction;
sootModel  none;

