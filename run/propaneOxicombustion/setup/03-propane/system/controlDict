FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solver             multicomponentFluid;

startFrom          latestTime;

startTime          0;

stopAt             endTime;

endTime            10000;

deltaT             1;

writeControl       runTime;

writeInterval      20;

purgeWrite         5;

writeFormat        ascii;

writePrecision     6;

writeCompression   off;

timeFormat         general;

timePrecision      6;

runTimeModifiable  true;

