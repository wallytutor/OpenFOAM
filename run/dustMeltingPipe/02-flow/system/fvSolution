FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "(p|rho)"
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-6;
        relTol          0.01;
    }

    // "(p|rho)Final"
    // {
    //     $p;
    //     relTol          0;
    // }

    "(U|e|h|k|omega)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-6;
        relTol          0.01;
    }

    // "(U|e|h|k|omega)Final"
    // {
    //     $U;
    //     tolerance       1e-05;
    //     relTol          0;
    // }
}

PIMPLE
{
    nNonOrthogonalCorrectors 0;

    // transonic       no;
    // consistent      yes;

    residualControl
    {
        p               1e-3;
        U               1e-4;
        h               1e-3;
        "(k|omega)"     1e-3;
    }
}

relaxationFactors
{
    fields
    {
        p               0.3;
    }

    equations
    {
        p               0.3;
        U               0.7;
        h               0.7;
        k               0.7;
        omega           0.7;
    }
}

