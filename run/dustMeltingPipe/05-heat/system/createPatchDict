FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      createPatchDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Following the discussion here:
// https://www.cfd-online.com/Forums/openfoam-meshing/
// 143087-pointwise-foam-cyclic-bc-points-order.html

patches
(
    {
        name fluidCyclicFront;
        patchInfo
        {
            type           cyclic;
            neighbourPatch fluidCyclicBack;
            transform      rotational;
            rotationAxis   (1 0 0);
            rotationCentre (0 0 0);
        }
        constructFrom patches;
        patches ( front );
    }
    {
        name fluidCyclicBack;
        patchInfo
        {
            type           cyclic;
            neighbourPatch fluidCyclicFront;
            transform      rotational;
            rotationAxis   (1 0 0);
            rotationCentre (0 0 0);
        }
        constructFrom patches;
        patches ( back );
    }
);

