FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 573.0;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"
    "(fluidCyclicFront|fluidCyclicBack)"
    {
        type            cyclic;
    }
    inlet
    {
        type            fixedValue;
        value           uniform 573.0;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform 573.0;
    }
    walls
    {
        type            zeroGradient;
    }
}


