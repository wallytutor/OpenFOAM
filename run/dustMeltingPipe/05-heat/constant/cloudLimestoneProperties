FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      limestoneCloudProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Need to artificially implement CaCO3 = CaO + CO2 with one of:
// type thermoCloud;   // No, only singlePhaseMixtureCoeffs
// type reactingCloud; // No, only singlePhaseMixtureCoeffs
type reactingMultiphaseCloud;

solution
{
    coupled                   true;
    transient                 no;
    cellValueSourceCorrection on;
    calcFrequency             10;
    maxTrackTime              0.3;
    maxCo                     0.2;

    sourceTerms
    {
        schemes
        {
            U               explicit 1;
            h               explicit 1;
            radiation       explicit 1;

            // For reactingMultiphaseCloud
            rho             explicit 1;
            Yi              explicit 1;
        }

        resetOnStartup true;
    }

    interpolationSchemes
    {
        rho             cell;
        mu              cell;
        U               cellPoint;
        Cp              cell;
        kappa           cell;
        p               cell;
        T               cell;
        G               cell;
    }

    integrationSchemes
    {
        U               Euler;
        T               analytical;
    }
}

constantProperties
{
    // https://cpp.openfoam.org/v13/classFoam_1_1MomentumParcel.html
    // parcelTypeId    2;

    // https://cpp.openfoam.org/v13/classFoam_1_1ThermoParcel_1_1constantProperties.html
    rho0            2500;
    T0              300;
    Cp0             900;
    epsilon0        1;
    f0              0.5;

    // https://cpp.openfoam.org/v13/classFoam_1_1ReactingMultiphaseParcel_1_1constantProperties.html
    TDevol          1143.0;
    LDevol          1e6;
    hRetentionCoeff 1;

    constantVolume  true;
}

subModels
{
    particleForces
    {
        sphereDrag;
        gravity;
    }

    injectionModels
    {
        dust
        {
            type              patchInjection;
            patchName         inlet;

            U0                (1.0 0.0 0.0);
            flowRateProfile   constant 1;
            uniformParcelSize nParticle;

            /*
            import math
            f    = 5/360    # Fraction of total pipe
            D    = 50e-6    # sizeDistribution.value
            rho  = 2500     # constantProperties.rho0
            mdot = 0.010    # mass flow rate
            N    = 100      # nParticle
            n = mdot / (rho * math.pi * (D**3) / 6)
            print(f"parcelsPerSecond {f * n / N:.0f};")
            print(f"nParticle        {N:.0f};")
            */
            parcelsPerSecond  8488;
            nParticle         100;

            SOI               0;
            duration          1.0e+304;

            sizeDistribution
            {
                type            fixedValue;
                value           100e-06;
            }
        }
    }

    // ----------------------------------------------------------------

    radiation on;

    // ----------------------------------------------------------------

    dispersionModel stochasticDispersionRAS;

    // ----------------------------------------------------------------

    patchInteractionModel standardWallInteraction;

    standardWallInteractionCoeffs
    {
        type            rebound;
        e               1;
        mu              0;
    }

    // ----------------------------------------------------------------

    heatTransferModel RanzMarshall;

    RanzMarshallCoeffs
    {
        BirdCorrection  false;
    }

    // ----------------------------------------------------------------

    phaseChangeModel none;

    // ----------------------------------------------------------------

    // https://cpp.openfoam.org/v13/classFoam_1_1ConstantRateDevolatilisation.html
    devolatilisationModel constantRateDevolatilisation;

    constantRateDevolatilisationCoeffs
    {
        volatileData
        (
            (CO2 12)
        );
        residualCoeff   0.001;
    }

    // ----------------------------------------------------------------

    stochasticCollisionModel none;

    // ----------------------------------------------------------------

    surfaceFilmModel none;

    // ----------------------------------------------------------------

    surfaceReactionModel none;

    // ----------------------------------------------------------------

    // https://cpp.openfoam.org/v13/classFoam_1_1SinglePhaseMixture.html
    // compositionModel singlePhaseMixture;

    compositionModel singleMixtureFraction;

    singlePhaseMixtureCoeffs
    {
        phases
        (
            solid
            {
                CaCO3   1;
            }
        );
    }

    /*
    M_CA = 40.078
    M_CC = 12.011
    M_OO = 15.999
    M_CaCO3 = M_CA + M_CC + 3*M_OO
    Y_gas = (M_CC + 2*M_OO) / M_CaCO3
    Y_sol = 1.0 - Y_gas
    */
    singleMixtureFractionCoeffs
    {
        phases
        (
            gas
            {
                CO2 1.0;
            }
            liquid
            {}
            solid
            {
                // CaO 1.0;
                CaCO3 1.0;
            }
        );

        YGasTot0        0.44;
        YLiquidTot0     0.00;
        YSolidTot0      0.56;
    }
}

cloudFunctions
{
    funcMassFlux
    {
        type massFlux;
    }
    funcPatchPostProcessing
    {
        type             patchPostProcessing;
        maxStoredParcels 10000;
        patches          ( outlet );
    }
}

