FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    // default          steadyState;
    default          localEuler;
}

gradSchemes
{
    default          Gauss linear;
}

divSchemes
{
    default          none;

    // Unless a bounded scheme is used, this fails!
    // flow             Gauss linearUpwind limited;
    flow             bounded Gauss upwind;

    div(phi,U)       $flow;
    div(phi,K)       $flow;
    div(phi,e)       $flow;
    div(phi,h)       $flow;
    div(phi,k)       $flow;
    div(phi,omega)   $flow;

    div(phi,Yi_h)    Gauss upwind;
    div(phid,p)      Gauss upwind;

    div(((rho*nuEff)*dev2(T(grad(U)))))      Gauss linear;
}

laplacianSchemes
{
    default          Gauss linear corrected;
}

interpolationSchemes
{
    default          linear;
}

snGradSchemes
{
    default          corrected;
}

wallDist
{
    method           meshWave;
}

