FROM ubuntu:24.04

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Allow OpenMPI to run as root inside the container
ENV OMPI_ALLOW_RUN_AS_ROOT=1
ENV OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1

# Install essential dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    wget \
    gnupg \
    util-linux \
    grep \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

##############################################################################
# Install OpenFOAM 13 from the official Ubuntu package
RUN wget -O - https://dl.openfoam.org/gpg.key > /etc/apt/trusted.gpg.d/openfoam.asc \
    && echo "deb http://dl.openfoam.org/ubuntu noble main" > /etc/apt/sources.list.d/openfoam.list \
    && apt-get update \
    && apt-get install -y --fix-missing -o Acquire::Retries=10 --no-install-recommends openfoam13 \
    && rm -rf /var/lib/apt/lists/*

##############################################################################
# Alternative approach: if image fails to build, try installing
# the OpenFOAM 13 deb package manually. First, navigate to
# https://sourceforge.net/projects/foam/files/foam/ubuntu/dists/noble/main/binary-amd64/
# and download the .deb package. Edit the version in COPY below if needed.
# COPY openfoam13_20260407_amd64.deb /tmp/
# RUN apt-get update \
#     && apt-get install -y --fix-missing --no-install-recommends /tmp/openfoam13_20260407_amd64.deb \
#     && rm -rf /tmp/openfoam13_20260407_amd64.deb \
#     && rm -rf /var/lib/apt/lists/*
##############################################################################

# Create working directory inside the container
WORKDIR /workspace

# Setup shell environment sourcing on interactive shell login
RUN echo "source /opt/openfoam13/etc/bashrc" >> /etc/bash.bashrc

# Set up an entrypoint script to automatically source OpenFOAM for all commands
RUN printf '#!/bin/bash\n\
source /opt/openfoam13/etc/bashrc\n\
exec "$@"\n' > /entrypoint.sh \
    && chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
