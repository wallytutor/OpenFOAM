#!/usr/bin/env python3
# -*- coding: utf-8 -*-

import os
import re
import shutil
import subprocess

from argparse import ArgumentParser
from pathlib import Path
from subprocess import run

from foamutils import Runner, Meshing
from foamutils import source_openfoam_env, common_arguments
from foamutils import banner as _banner

HERE = Path(__file__).resolve().parent


def main():
    os.chdir(HERE)

    parser = common_arguments()
    args = parser.parse_args()

    if not (args.mesh or args.run or args.clean or args.reconstruct):
        parser.print_help()
        return

    if args.clean and not (args.mesh or args.run):
        _clean()
        return

    if args.reconstruct and not (args.mesh or args.run):
        # _reconstruct(latest=args.latest)
        return

    if args.mesh:
        if args.clean:
            _clean()
        else:
            ans = input(
                "Do you want to clean the case before meshing? (y/N): "
            )

            if ans.strip().lower() in ("y", "yes"):
                _clean()

        Path("case.foam").touch()

        Meshing.gmsh_to_foam_single_region(
            mesh_file = "constant/geometry/domain.msh",
            patching  = fn_patching
        )
        return

    if args.run:
        Path("case.foam").touch()

        Runner.foam_run(
            cores       = args.cores,
            reconstruct = args.reconstruct,
            preprocess  = fn_preprocessing,
            decomposing = get_fn_parallel(args.cores),
            latest      = args.latest
        )
        return


def _clean():
    cwd = Path(HERE)

    # Remove numeric time directories in cwd (e.g. "0.1", "100", etc.)
    for item in cwd.iterdir():
        if item.is_dir() and re.match(r"^[0-9]+(\.[0-9]+)?$", item.name):
            shutil.rmtree(item, ignore_errors=True)

    dirs_to_remove = [
        cwd / "0",
        cwd / "constant" / "extendedFeatureEdgeMesh",
        cwd / "constant" / "polyMesh",
        cwd / "postProcessing",
    ]

    for p in dirs_to_remove:
        if p.is_dir():
            shutil.rmtree(p, ignore_errors=True)

    geom_dir = cwd / "constant" / "geometry"

    if geom_dir.is_dir():
        for f in geom_dir.glob("*.eMesh"):
            if f.is_file():
                f.unlink(missing_ok=True)

    for p in cwd.glob("processor*"):
        if p.is_dir():
            shutil.rmtree(p, ignore_errors=True)

    case_foam = cwd / "case.foam"

    if case_foam.exists():
        case_foam.unlink(missing_ok=True)

    for log_file in cwd.glob("log.*"):
        if log_file.is_file():
            log_file.unlink(missing_ok=True)


def fn_preprocessing():
    """ Copy initial conditions to the *zero* directory. """
    zero_dir = Path("0")

    if zero_dir.exists():
        shutil.rmtree(zero_dir, ignore_errors=True)

    if Path("0.orig").exists():
        shutil.copytree("0.orig", zero_dir)


def fn_patching():
    file = "constant/polyMesh/boundary"

    changes = [
        ("entry0/front/type",         "wedge"),
        ("entry0/back/type",          "wedge"),
        ("entry0/pipeInnerWall/type", "wall"),
        ("entry0/pipeOuterWall/type", "wall"),
        ("entry0/pipeEndWall/type",   "wall"),
        ("entry0/ductWalls/type",     "wall"),
    ]

    for entry, value in changes:
        Runner.dict_set_entry(file, entry, value)


def get_fn_parallel(cores: int):
    def patching():
        dict_orig = Path("system/decomposeParDict.orig")
        dict_file = Path("system/decomposeParDict")

        if not dict_file.exists():
            shutil.copy(dict_orig, dict_file)

        match cores:
            case 4:
                n_coeffs = "(1 2 2)"
            case 20:
                n_coeffs = "(2 2 5)"
            case 32:
                n_coeffs = "(2 4 4)"
            case 40:
                n_coeffs = "(2 4 5)"
            case _:
                raise ValueError(f"Unsupported core count: {cores}")

        file = str(dict_file)
        Runner.dict_set_entry(file, "numberOfSubdomains", f"{cores}")
        Runner.dict_set_entry(file, "simpleCoeffs/n", n_coeffs)

    return patching


if __name__ == "__main__":
    main()
