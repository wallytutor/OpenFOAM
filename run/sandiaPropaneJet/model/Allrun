#!/usr/bin/env bash

# Run from this directory:
cd ${0%/*} || exit 1

# Sourcing OpenFOAM v13 environment
if [ -f /opt/openfoam13/etc/bashrc ]; then
    . /opt/openfoam13/etc/bashrc
fi

# Source tutorial run functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions

# Parse core count
CORES=${1:-1}
if [ "$CORES" != "1" ] && [ "$CORES" != "4" ] && [ "$CORES" != "20" ]; then
    echo "Error: Unsupported core count: $CORES. Supported values: 1, 4, 20"
    exit 1
fi

# To open case with ParaView:
touch case.foam

echo "=========================================="
echo "Starting simulation with $CORES core(s)"
echo "=========================================="

# Copy initial conditions:
cp -avr 0.orig/ 0/

# Run simulation:
if [ "$CORES" = "1" ]; then
    # Sequential execution
    runApplication foamRun &> log.foamRun
else
    # Decompose domain:
    source ./parallel

    # Run snappyHexMesh in parallel
    runParallel foamRun

    # Reconstruct parallel mesh
    # runApplication reconstructPar -constant

    # Clean up processor directories
    # rm -rf processor*
fi

echo "=========================================="
echo "Simulation complete!"
echo "=========================================="