FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#includeEtc "caseDicts/mesh/generation/snappyHexMeshDict.cfg"

castellatedMesh true;
snap            true;
addLayers       true;

geometry
{
    // ---------------------------------------------------------------
    // Actual geometry
    // ---------------------------------------------------------------

    ductWalls
    {
        type triSurfaceMesh;
        file "ductWalls.stl";
    }
    inletCoflow
    {
        type triSurfaceMesh;
        file "inletCoflow.stl";
    }
    inletFuel
    {
        type triSurfaceMesh;
        file "inletFuel.stl";
    }
    outlet
    {
        type triSurfaceMesh;
        file "outlet.stl";
    }
    pipeEndWall
    {
        type triSurfaceMesh;
        file "pipeEndWall.stl";
    }
    pipeInnerWall
    {
        type triSurfaceMesh;
        file "pipeInnerWall.stl";
    }
    pipeOuterWall
    {
        type triSurfaceMesh;
        file "pipeOuterWall.stl";
    }

    // ---------------------------------------------------------------
    // Meshing auxiliaries
    // ---------------------------------------------------------------

    refinementCylinderTip
    {
        type cylinder;
        point1 (0.0  0.0 -0.02);
        point2 (0.0  0.0  0.05);
        radius 0.008;
    }
    refinementCylinderMain
    {
        type cylinder;
        point1 (0.0  0.0  0.00);
        point2 (0.0  0.0  0.25);
        radius 0.025;
    }
}

castellatedMeshControls
{
    // Point inside fluid volume, used to crop the background mesh.
    insidePoint (0 0 1);

    // The maximum number of cells allowed per processor during
    // the refinement stage.
    maxLocalCells 500000;

    // The overall cell limit across all processors during refinement,
    // applied before the cell removal stage.
    maxGlobalCells 4000000;

    // The threshold for stopping surface refinement; if the number of
    // cells targeted for refinement falls below this number, surface
    // refinement stops.
    minRefinementCells 50000;

    // This specifies the number of buffer layers of cells that must exist
    // between successive levels of mesh refinement (typically set to 3 to
    // ensure a smooth transition).
    nCellsBetweenLevels  3;

    // Resolve feature angle; if this value is too high (e.g., set to 100),
    // the mesher will ignore sharp angle intersections, leading to a
    // highly distorted castellated grid at the corners. Keep default.
    resolveFeatureAngle 30;


    features
    (
        {
            // Use a high refinement level to capture 90° corners when
            // castellating with a coarse background mesh.
            file "ductWalls.eMesh";
            level 3;
        }
        {
            file "inletCoflow.eMesh";
            level 3;
        }
        {
            file "inletFuel.eMesh";
            level 3;
        }
        {
            file "outlet.eMesh";
            level 1;
        }
        {
            file "pipeEndWall.eMesh";
            level 3;
        }
        {
            file "pipeInnerWall.eMesh";
            level 3;
        }
        {
            file "pipeOuterWall.eMesh";
            level 3;
        }
    );

    refinementSurfaces
    {
        ductWalls
        {
            level (2 2);
            patchInfo
            {
                type wall;
            }
        }
        inletCoflow
        {
            level (2 2);
            patchInfo
            {
                type patch;
            }
        }
        inletFuel
        {
            level (2 2);
            patchInfo
            {
                type patch;
            }
        }
        outlet
        {
            level (1 1);
            patchInfo
            {
                type patch;
            }
        }
        pipeEndWall
        {
            level (2 2);
            patchInfo
            {
                type wall;
            }
        }
        pipeInnerWall
        {
            level (2 2);
            patchInfo
            {
                type wall;
            }
        }
        pipeOuterWall
        {
            level (2 2);
            patchInfo
            {
                type wall;
            }
        }
    }

    refinementRegions
    {
        refinementCylinderTip
        {
            mode distance;
            levels (
                (0.008 3)
                (0.016 2)
            );
        }
        refinementCylinderMain
        {
            mode distance;
            levels (
                (0.025 2)
                (0.050 1)
            );
        }
    }
}

snapControls
{
    // Specifies the number of patch smoothing iterations performed
    // before finding the correspondence to the surface (typically
    // set to 3).
    // This specifies the number of patch smoothing iterations performed
    // before finding the correspondence to the surface (typically
    // set to 3).
    nSmoothPatch 3;

    // The ratio of the distance for points to be attracted by a
    // surface feature point or edge, to the local maximum edge length
    // (typically set to 2.0). Increasing produces a sharper snapping.
    tolerance 1.0;

    // The number of mesh displacement relaxation iterations (typically
    // in the range of 30 to 100).
    nSolveIter 300;

    // The maximum number of snapping relaxation iterations (typically
    // set to 5).
    nRelaxIter 5;

    // This specifies the number of feature edge snapping iterations. It
    // dictates how many passes the snapping driver executes to align
    // nodes directly with sharp feature lines. Leaving it out or
    //setting it to 0 completely disables sharp feature edge snapping.
    nFeatureSnapIter 10;

    // When set to true (the default), the snapping driver uses
    // explicitly defined feature lines (File-Based Snapping) loaded
    // in the castellatedMeshControls.features dictionary (typically
    // .eMesh files generated by the surfaceFeatures utility).
    explicitFeatureSnap true;

    // When set to true, the mesh generator implicitly detects
    // geometric features by dynamically sampling the surface.
    implicitFeatureSnap true;

    // Allow snapping to feature lines in multiple regions. Required for
    // resolving angle between inlet and the pipe walls, as they are in
    // separate patches.
    multiRegionFeatureSnap true;
}

addLayersControls
{
    layers
    {
        ductWalls
        {
            nSurfaceLayers 3;
        }
        pipeEndWall
        {
            nSurfaceLayers 4;
        }
        pipeOuterWall
        {
            nSurfaceLayers 4;
        }
        pipeInnerWall
        {
            nSurfaceLayers 4;
        }
    }

    relativeSizes       true;
    expansionRatio      1.2;
    finalLayerThickness 0.3;
    minThickness        0.05;
}

