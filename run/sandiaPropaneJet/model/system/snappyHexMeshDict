FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#includeEtc "caseDicts/mesh/generation/snappyHexMeshDict.cfg"

castellatedMesh true;
snap            true;
addLayers       true;

geometry
{
    ductWalls
    {
        type triSurfaceMesh;
        file "ductWalls.stl";
    }
    inletCoflow
    {
        type triSurfaceMesh;
        file "inletCoflow.stl";
    }
    inletFuel
    {
        type triSurfaceMesh;
        file "inletFuel.stl";
    }
    outlet
    {
        type triSurfaceMesh;
        file "outlet.stl";
    }
    pipeEndWall
    {
        type triSurfaceMesh;
        file "pipeEndWall.stl";
    }
    pipeInnerWall
    {
        type triSurfaceMesh;
        file "pipeInnerWall.stl";
    }
    pipeOuterWall
    {
        type triSurfaceMesh;
        file "pipeOuterWall.stl";
    }
    refinementCylinderTip
    {
        type cylinder;
        point1 (0.0  0.0  0.0);
        point2 (0.0  0.0  0.05);
        radius 0.008;
    }
    refinementCylinderMain
    {
        type cylinder;
        point1 (0.0  0.0  0.0);
        point2 (0.0  0.0  0.25);
        radius 0.025;
    }
}

castellatedMeshControls
{
    features
    (
        {
            file "ductWalls.eMesh";
            level 1;
        }
        {
            file "inletCoflow.eMesh";
            level 1;
        }
        {
            file "inletFuel.eMesh";
            level 2;
        }
        {
            file "outlet.eMesh";
            level 1;
        }
        {
            file "pipeEndWall.eMesh";
            level 2;
        }
        {
            file "pipeInnerWall.eMesh";
            level 4;
        }
        {
            file "pipeOuterWall.eMesh";
            level 2;
        }
    );

    refinementSurfaces
    {
        ductWalls
        {
            level (1 1);
            patchInfo
            {
                type wall;
            }
        }
        inletCoflow
        {
            level (1 1);
            patchInfo
            {
                type patch;
            }
        }
        inletFuel
        {
            level (2 2);
            patchInfo
            {
                type patch;
            }
        }
        outlet
        {
            level (1 1);
            patchInfo
            {
                type patch;
            }
        }
        pipeEndWall
        {
            level (2 2);
            patchInfo
            {
                type wall;
            }
        }
        pipeInnerWall
        {
            level (3 4);
            patchInfo
            {
                type wall;
            }
        }
        pipeOuterWall
        {
            level (2 3);
            patchInfo
            {
                type wall;
            }
        }
    }

    refinementRegions
    {
        refinementCylinderTip
        {
            mode distance;
            levels ((0.008 3) (0.016 2));
        }
        refinementCylinderMain
        {
            mode distance;
            levels ((0.025 2) (0.05 1));
        }
    }

    insidePoint (0 0 1);
}

snapControls
{
    explicitFeatureSnap    true;
    implicitFeatureSnap    false;
}

addLayersControls
{
    layers
    {
        ductWalls
        {
            nSurfaceLayers 2;
        }
        pipeEndWall
        {
            nSurfaceLayers 4;
        }
        pipeOuterWall
        {
            nSurfaceLayers 4;
        }
        pipeInnerWall
        {
            nSurfaceLayers 4;
        }
    }

    relativeSizes       true;
    expansionRatio      1.2;
    finalLayerThickness 0.3;
    minThickness        0.05;
}

