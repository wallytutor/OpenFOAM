#!/usr/bin/env bash

# Run from this directory:
cd ${0%/*} || exit 1

# Source tutorial run functions:
. $WM_PROJECT_DIR/bin/tools/RunFunctions

# Make sure mesh exists:
if [ ! -d "constant/polyMesh" ]; then
    ./domain.sh
fi

# To open with ParaView:
touch case.foam

# Partial clean just to run again:
rm -rf 200/ processor* log.*

# Restart case:
cp -r restart/ 200/

# Make spark for combustion:
runApplication setFields -latestTime

# Extend time:
file=system/controlDict
foamDictionary $file -entry endTime -set 10000 > /dev/null

# Parameterize compatible with combustion:
file=system/fvSolution
foamDictionary $file -entry PIMPLE/maxCo    -set 0.2 > /dev/null
foamDictionary $file -entry PIMPLE/alphaY   -set 0.1 > /dev/null
foamDictionary $file -entry PIMPLE/Yref/CH4 -set 0.1 > /dev/null
foamDictionary $file -entry PIMPLE/Yref/O2  -set 0.1 > /dev/null

# Decompose the domain:
runApplication decomposePar -latestTime
mv log.decomposePar log.decomposePar.2

# Run the simulation:
runParallel foamRun
mv log.foamRun log.foamRun.2

# Restore modified files
git restore system/controlDict
git restore system/fvSolution

#------------------------------------------------------------------------------