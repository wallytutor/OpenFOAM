#!/usr/bin/env bash

# Run from this directory:
cd ${0%/*} || exit 1

# Source tutorial run functions:
. $WM_PROJECT_DIR/bin/tools/RunFunctions

# Make sure mesh exists:
if [ ! -d "constant/polyMesh" ]; then
    ./domain.sh
fi

# To open with ParaView:
touch case.foam

# Final step of run 1:
tend=1500

if [ ! -d "restart" ]; then
    # Copy initial conditions:
    cp -r 0.orig/ 0/

    # Decompose the domain:
    runApplication decomposePar
    mv log.decomposePar log.decomposePar.1

    # Ensure consistent end-time:
    file=system/controlDict
    foamDictionary $file -entry endTime -set $tend > /dev/null

    # Run the simulation:
    runParallel foamRun
    mv log.foamRun log.foamRun.1

    # Reconstruct the solution:
    runApplication reconstructPar -latestTime
    mv log.reconstructPar log.reconstructPar.1

    # Remove decomposition files:
    rm -rf processor*

    # Backup before setFields for restart purposes:
    mv $tend/ restart/
fi

# Partial clean just to run again:
rm -rf 0/ processor* log.*

# Restart case:
cp -r restart/ 0/

# Make spark for combustion:
runApplication setFields -latestTime

# Extend time:
file=system/controlDict
foamDictionary $file -entry endTime -set 10000 > /dev/null

# Parameterize compatible with combustion:
file=system/fvSolution
foamDictionary $file -entry PIMPLE/maxCo     -set 0.2 > /dev/null
foamDictionary $file -entry PIMPLE/alphaY    -set 0.1 > /dev/null
foamDictionary $file -entry PIMPLE/alphaTemp -set 0.1 > /dev/null
foamDictionary $file -entry PIMPLE/Yref/CH4  -set 0.1 > /dev/null
foamDictionary $file -entry PIMPLE/Yref/O2   -set 0.1 > /dev/null

# Decompose the domain:
runApplication decomposePar -latestTime
mv log.decomposePar log.decomposePar.2

# Run the simulation:
runParallel foamRun
mv log.foamRun log.foamRun.2

# Restore modified files
git restore system/controlDict
git restore system/fvSolution

#------------------------------------------------------------------------------