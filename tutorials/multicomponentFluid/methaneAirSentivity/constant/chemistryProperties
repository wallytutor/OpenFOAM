FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      chemistryProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

chemistry               on;
initialChemicalTimeStep 1.0e-08;

chemistryType
{
    solver         ode;
}

odeCoeffs
{
    // Extrapolation solvers (seulex) are fragile when handling near-zero
    // species with fractional reaction orders. OpenFOAM 13 provides
    // Rosenbrock-type stiff ODE solvers that handle ill-conditioned
    // Jacobians without underflow:
    // solver          rodas23;
    solver          rodas34;
    // solver          Rosenbrock34;
    // solver          seulex;

    absTol          1.0e-08;
    relTol          1.0e-02;
    maxSteps        30000;
}

#include "reactions"

