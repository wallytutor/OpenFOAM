FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      chemistryProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

chemistry               on;
initialChemicalTimeStep 1.0e-7;

chemistryType
{
    solver         ode;
}

odeCoeffs
{
    solver          seulex;
    absTol          1.0e-08;
    relTol          1.0e-03;
    maxSteps        50000;
}

#include "reactions"

