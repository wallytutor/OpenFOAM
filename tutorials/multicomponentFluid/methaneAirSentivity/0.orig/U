FoamFile
{
    format    ascii;
    class     volVectorField;
    location  "0";
    object    U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions     [0 1 -1 0 0 0 0];

internalField  uniform (0 0 0);

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    inletAxial
    {
        type          flowRateInletVelocity;
        massFlowRate  constant 1.639491e-02;
        profile       turbulentBL;
        rhoInlet      1.802423e+00;
    }
    inletAnnular
    {
        type          flowRateInletVelocity;
        massFlowRate  constant 1.427592e-02;
        profile       turbulentBL;
        rhoInlet      1.307888e+00;
    }
    outlet
    {
        type          pressureInletOutletVelocity;
        value         $internalField;
    }
    walls
    {
        type          noSlip;
    }
}

