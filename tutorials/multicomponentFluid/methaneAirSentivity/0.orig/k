FoamFile
{
    format    ascii;
    class     volScalarField;
    location  "0";
    object    k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions     [0 2 -2 0 0 0 0];

internalField  uniform 10;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    inletAxial
    {
        type          turbulentIntensityKineticEnergyInlet;
        intensity     5.000000e-02;
        value         uniform 1.208000e+00;
    }
    inletAnnular
    {
        type          turbulentIntensityKineticEnergyInlet;
        intensity     5.000000e-02;
        value         uniform 6.961000e+00;
    }
    outlet
    {
        type          inletOutlet;
        inletValue    uniform 1;
        value         uniform 1;
    }
    walls
    {
        type          kqRWallFunction;
        value         uniform 1;
    }
}

