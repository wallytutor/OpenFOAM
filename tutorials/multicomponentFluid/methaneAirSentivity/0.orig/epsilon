FoamFile
{
    format    ascii;
    class     volScalarField;
    location  "0";
    object    epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions     [0 2 -3 0 0 0 0];

internalField  uniform 100;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    inletAxial
    {
        type          turbulentMixingLengthDissipationRateInlet;
        mixingLength  4.445000e-04;
        value         uniform 4.910690e+02;
    }
    inletAnnular
    {
        type          turbulentMixingLengthDissipationRateInlet;
        mixingLength  4.445000e-04;
        value         uniform 6.788532e+03;
    }
    outlet
    {
        type          inletOutlet;
        inletValue    uniform 1000;
        value         uniform 1000;
    }
    walls
    {
        type          epsilonWallFunction;
        value         uniform 1000;
    }
}

