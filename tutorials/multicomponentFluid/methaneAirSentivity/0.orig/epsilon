FoamFile
{
    format    ascii;
    class     volScalarField;
    location  "0";
    object    epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions     [0 2 -3 0 0 0 0];

internalField  uniform 100;

#include "_shared"

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    inletAxial
    {
        type          turbulentMixingLengthDissipationRateInlet;
        mixingLength  $FUEL_L;
        value         uniform $FUEL_EPSILON;
    }
    inletAnnular
    {
        type          turbulentMixingLengthDissipationRateInlet;
        mixingLength  $OXID_L;
        value         uniform $OXID_EPSILON;
    }
    outlet
    {
        type          inletOutlet;
        inletValue    uniform 0;
        value         uniform 0;
    }
    walls
    {
        type          epsilonWallFunction;
        value         uniform 0;
    }
}

