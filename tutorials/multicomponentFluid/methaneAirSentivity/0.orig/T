FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 298.15;

#include "_shared"

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    inletAxial
    {
        type            fixedValue;
        value           uniform $FUEL_T;
    }
    inletAnnular
    {
        type            fixedValue;
        value           uniform $OXID_T;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      $internalField;
        value           $internalField;
    }
    walls
    {
        type            zeroGradient;
    }
}

