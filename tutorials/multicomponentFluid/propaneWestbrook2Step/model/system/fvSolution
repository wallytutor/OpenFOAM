FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "rho.*"
    {
        solver          diagonal;
    }

    p
    {
        solver           GAMG;
        smoother         GaussSeidel;
        tolerance        1e-6;
        relTol           0.05;
    }

    pFinal
    {
        $p;
        relTol           0.01;
    }

    "(U|h|k|epsilon)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1.0e-06;
        relTol          0.10;
    }

    "(U|h|k|epsilon)Final"
    {
        $U;
        relTol          0.05;
    }

    "Yi.*"
    {
        $U;
        relTol          0.01;
    }

    G
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-5;
        relTol          0.1;
    }

    GFinal
    {
        $G;
        relTol          0.01;
    }
}

PIMPLE
{
    nCorrectors               2;
    nOuterCorrectors          1;
    nNonOrthogonalCorrectors  0;
    momentumPredictor         no;
    transonic                 no;
    consistent                yes;

    // Primary time scale controls; minDeltaT is probably a bad idea!
    maxCo                     50.0;
    maxDeltaT                 1.0e-01;
    // minDeltaT                 1.0e-07;

    // Increase as much as possible: this parameters tries to
    // smooth rDeltaT (the local inverse time-step) and a lower
    // value will drag everything down to the lower chemical
    // time-step, making the simulation stable but slow.
    rDeltaTSmoothingCoeff     1.0;
    rDeltaTDampingCoeff       1.0;
    alphaTemp                 1.0;
    alphaY                    1.0;

    Yref
    {
        C3H8  1.0;
        O2    1.0;
    }
}

relaxationFactors
{
    fields
    {
        p       0.3;
        rho     1.0;
    }
    equations
    {
        // This makes no sense in LTS!
        // U       0.7;
        // h       0.7;
        // "Yi.*"  0.7;
        // k       0.5;
        // epsilon 0.5;
        ".*"            1.0;
    }
}

