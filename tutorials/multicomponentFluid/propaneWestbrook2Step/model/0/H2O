FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      H2O;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [];

internalField   uniform 0.0985;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    inletAxial
    {
        type            fixedValue;
        value           uniform 0;
    }
    inletAnnular
    {
        type            fixedValue;
        value           uniform 0;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform 0; // 0.0985;
        value           uniform 0; // 0.0985;
    }
    walls
    {
        type            zeroGradient;
    }
}

