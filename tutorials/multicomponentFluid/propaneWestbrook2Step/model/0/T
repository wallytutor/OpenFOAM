FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 298.15;

#include "$FOAM_CASE/constant/initialConditions"

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    inletAxial
    {
        type            fixedValue;
        value           uniform $FUEL_T;
    }
    inletAnnular
    {
        type            fixedValue;
        value           uniform $OXID_T;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      $internalField;
        value           $internalField;
    }
    walls
    {
        // type            zeroGradient;
        type            externalTemperature;
        Ta              constant 298.15;
        h               uniform 10.0;
        thicknessLayers ( 0.28 );
        kappaLayers     ( 1.8 );
        value           $internalField;
    }
}

