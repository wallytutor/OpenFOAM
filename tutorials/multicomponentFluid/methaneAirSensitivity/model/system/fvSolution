FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "rho.*"
    {
        solver          diagonal;
    }

    p
    {
        solver           GAMG;
        smoother         GaussSeidel;
        tolerance        1e-6;
        relTol           0.05;
    }

    pFinal
    {
        $p;
        relTol           0.01;
    }

    "(U|h|k|epsilon)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1.0e-06;
        relTol          0.10;
    }

    "(U|h|k|epsilon)Final"
    {
        $U;
        relTol          0.05;
    }

    "Yi.*"
    {
        $U;
        relTol          0.01;
    }

    G
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-5;
        relTol          0.1;
    }

    GFinal
    {
        $G;
        relTol          0.01;
    }
}

PIMPLE
{
    nCorrectors               2;
    nOuterCorrectors          1;
    nNonOrthogonalCorrectors  0;
    momentumPredictor         no;
    transonic                 no;
    consistent                yes;
    maxCo                     10.0;
    maxDeltaT                 0.1;
    rDeltaTSmoothingCoeff     0.3;
    rDeltaTDampingCoeff       1.0;
    alphaTemp                 0.2;
    alphaY                    1.0;

    Yref
    {
        CH4   1.0;
        O2    1.0;
    }
}

relaxationFactors
{
    fields
    {
        p               0.3;
        rho             1.0;
    }
    equations
    {
        ".*"            1.0;
    }
}

