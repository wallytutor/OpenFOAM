#!/bin/sh
cd "${0%/*}" || exit

# Source OpenFOAM environment if not already loaded
if [ -z "$WM_PROJECT_DIR" ]; then
    if [ -f /opt/openfoam13/etc/bashrc ]; then
        . /opt/openfoam13/etc/bashrc
    fi
fi

wclean
if [ -n "$FOAM_USER_APPBIN" ]; then
    rm -f "$FOAM_USER_APPBIN"/testTabulatedSolid
fi
