#!/usr/bin/env bash

# Path to this script:
FOAM_KOMPANION_ETC="$(cd "$(dirname "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"

# Get repository root directory (parent of etc/):
FOAM_KOMPANION_DIR="$(dirname "${FOAM_KOMPANION_ETC}")"

function foam_source_append() {
    FOAM_BASHRC="${FOAM_KOMPANION_ETC}/bashrc"

    FOAM_SOURCE="
    if [ -f \"$FOAM_BASHRC\" ]; then
        source \"$FOAM_BASHRC\"
    fi
    "

    if ! grep -F -q "${FOAM_BASHRC}" "$HOME/.bashrc"; then
        echo "$FOAM_SOURCE" >> ~/.bashrc
    else
        echo "OpenFOAM already sourced in ~/.bashrc"
    fi
}

##############################################################################
# OpenFOAM
##############################################################################

# Handle OpenFOAM environment sourcing and tweaks:
if [ ! -f "/opt/openfoam13/etc/bashrc" ]; then
    echo "OpenFOAM environment not found."
    exit 1
fi

# Pre-source full OpenFOAM environment:
if [ ! -v WM_PROJECT ]; then
    . /opt/openfoam13/etc/bashrc
fi

# Source tutorial clean/run functions:
. $WM_PROJECT_DIR/bin/tools/CleanFunctions
. $WM_PROJECT_DIR/bin/tools/RunFunctions

# Tweak OpenFOAM environment variables:
export WM_PROJECT_USER_DIR="${FOAM_KOMPANION_DIR}"
export FOAM_RUN="${FOAM_KOMPANION_DIR}/run"
export FOAM_USER_APPBIN="${FOAM_KOMPANION_DIR}/platforms/${WM_OPTIONS}/bin"
export FOAM_USER_LIBBIN="${FOAM_KOMPANION_DIR}/platforms/${WM_OPTIONS}/lib"

# Add user directories to path:
export PATH="${FOAM_USER_APPBIN}:${PATH}"
export LD_LIBRARY_PATH="${FOAM_USER_LIBBIN}:${LD_LIBRARY_PATH}"

##############################################################################
# User scripts
##############################################################################

# Source all *rc files in the script directory:
# XXX prefer manual sourcing as order matters!
. "${FOAM_KOMPANION_ETC}/rc/utilsrc"
. "${FOAM_KOMPANION_ETC}/rc/coresrc"
. "${FOAM_KOMPANION_ETC}/rc/meshingrc"
. "${FOAM_KOMPANION_ETC}/rc/flowrc"
. "${FOAM_KOMPANION_ETC}/rc/aliasrc"

##############################################################################
# Configuration
##############################################################################

NVIM_VER=$(nvim --version | head -n1 | sed 's/^NVIM v//')

# check if >= 0.10
if printf '%s\n' "$NVIM_VER" "0.10" | sort -V | head -n1 | grep -q "0.10"; then
    export XDG_CONFIG_HOME="${FOAM_KOMPANION_DIR}/etc/nvim"
fi

if command -v nvim >/dev/null 2>&1; then
    alias vi="nvim"
    alias vim="nvim"
fi

export IPYTHONDIR="${FOAM_KOMPANION_ETC}/.ipython"
# export JUPYTER_DATA_DIR="${SCRIPT_DIR}/../.jupyter"
# export JUPYTER_PATH="${SCRIPT_DIR}/../.jupyter"
# export VSCODE_EXTENSIONS="${SCRIPT_DIR}/../.vscode/extensions"
# export VSCODE_SETTINGS="${SCRIPT_DIR}/../.vscode/user-data"

# Source Rust
if [ -f "${HOME}/.cargo/env" ]; then
    source "${HOME}/.cargo/env"
fi

if [ -f "${HOME}/.local/bin/env" ]; then
    source "${HOME}/.local/bin/env"
fi

# Color codes
CYAN="\[\e[36m\]"
GREY="\[\e[90m\]"
RESET="\[\e[0m\]"

# Prompt: "<folder> > "
PS1="${CYAN}\W${GREY} > ${RESET}"

##############################################################################
# EOF
##############################################################################