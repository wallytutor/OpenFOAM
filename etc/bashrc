#!/usr/bin/env bash

# Handle OpenFOAM environment sourcing and tweaks:
if [ ! -f "/opt/openfoam13/etc/bashrc" ]; then
    echo "OpenFOAM environment not found."
    exit 1
fi

# Pre-source full OpenFOAM environment:
source /opt/openfoam13/etc/bashrc

# Path to this script:
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

# Get repository root directory (parent of etc/):
PROJECT_DIR="$(dirname "${SCRIPT_DIR}")"

# Path to scripts directory:
PROJECT_RCS="${SCRIPT_DIR}/rc"

# Tweak OpenFOAM environment variables:
export WM_PROJECT_USER_DIR="${PROJECT_DIR}"
export FOAM_RUN="${PROJECT_DIR}/run"
export FOAM_USER_APPBIN="${PROJECT_DIR}/platforms/${WM_OPTIONS}/bin"
export FOAM_USER_LIBBIN="${PROJECT_DIR}/platforms/${WM_OPTIONS}/lib"

# Add user directories to path:
export PATH="${FOAM_USER_APPBIN}:${PATH}"
export LD_LIBRARY_PATH="${FOAM_USER_LIBBIN}:${LD_LIBRARY_PATH}"

# Source all *rc files in the script directory:
if [ -d "${PROJECT_RCS}" ]; then
    for rc_file in "${PROJECT_RCS}"/*rc; do
        if [ -f "${rc_file}" ]; then
            # echo "Sourcing ${rc_file}"
            source "${rc_file}"
        fi
    done
fi

# Source this file again:
alias src="source ${SCRIPT_DIR}/bashrc"

# Alias for listing directory contents:
alias ll='ls -Alh --group-directories-first | sort -k9 -V -r'
alias ls='ls -lh --group-directories-first'

# Aliases for screen (a CFD must-have):
alias scl="screen -ls"
alias scx="screen -x"
alias scs="screen -S"
alias scr="screen -r"
