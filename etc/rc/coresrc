#!/usr/bin/env bash

# Path to this script:
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
. "${SCRIPT_DIR}/utilsrc"

get_physical_cores() {
    # Get the number of physical CPU cores.
    #
    # Usage:
    #   get_physical_cores
    #
    # Description:
    #   Uses `lscpu` parse output and counts unique socket/core pairs.
    #   Prints the physical core count to stdout.
    #
    # Returns:
    #   0 on success (prints integer core count), non-zero on failure.
    #
    # Examples:
    #   get_physical_cores

    if ! command -v lscpu > /dev/null 2>&1; then
        error_message "Cannot determine physical cores as lscpu command is not found. " >&2
        return 1
    fi

    local phys_cores
    phys_cores=$(lscpu -p=core,socket | grep -v '^#' | sort -u | wc -l) || return 1

    if [ -z "$phys_cores" ] || ! [[ "$phys_cores" =~ ^[0-9]+$ ]] || [ "$phys_cores" -le 0 ]; then
        error_message "Failed to parse physical core count from lscpu output." >&2
        return 1
    fi

    echo "$phys_cores"
}

safe_run_ncores() {
    # Return a safe number of cores for execution.
    #
    # Usage:
    #   safe_run_ncores REQUESTED_CORES [FALLBACK_CORES...]
    #
    # Arguments:
    #   REQUESTED_CORES       Primary number of cores requested by the caller
    #   FALLBACK_CORES...     Optional fallback core counts to try in order
    #
    # Description:
    #   Returns the requested core count if it does not exceed physical cores.
    #   If it exceeds physical cores, attempts each optional fallback core count
    #   in order. If none of the requested or fallback core counts are feasible,
    #   returns half the number of available physical cores (at least 1).
    #   Diagnostics are printed to stderr; stdout only prints the final integer.
    #
    # Returns:
    #   0 on success (prints integer core count), non-zero on failure.
    #
    # Examples:
    #   safe_run_ncores 8
    #   safe_run_ncores 128 48
    #   safe_run_ncores 128 64 32 16
    #   ncores=$(safe_run_ncores 128 64 32 16)

    if [ $# -eq 0 ]; then
        error_message "Missing REQUESTED_CORES argument." >&2
        return 1
    fi

    for arg in "$@"; do
        if ! [[ "$arg" =~ ^[0-9]+$ ]] || [ "$arg" -le 0 ]; then
            error_message "Core count arguments must be positive integers (got '$arg')." >&2
            return 1
        fi
    done

    local phys_cores
    phys_cores=$(get_physical_cores) || return 1

    local requested_cores="$1"
    local half_cores=$(( phys_cores / 2 ))
    [ "$half_cores" -le 0 ] && half_cores=1

    if [ "$requested_cores" -le "$phys_cores" ]; then
        echo "$requested_cores"
        return 0
    fi

    warning_message "Requested cores ($requested_cores) exceed physical cores ($phys_cores)." >&2

    shift
    while [ $# -gt 0 ]; do
        local fallback="$1"
        if [ "$fallback" -le "$phys_cores" ]; then
            warning_message "Using fallback cores ($fallback) instead of requested $requested_cores." >&2
            echo "$fallback"
            return 0
        else
            warning_message "Fallback cores ($fallback) exceed physical cores ($phys_cores)." >&2
        fi
        shift
    done

    warning_message "Using half of physical cores ($half_cores) instead of requested $requested_cores." >&2
    echo "$half_cores"
    return 0
}
